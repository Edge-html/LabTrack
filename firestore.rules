rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ── users ───────────────────────────────────────────────────────────────
    match /users/{uid} {
      // A signed-in user can read their own doc; admin can read all
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Create: only with role="student", matching uid, valid grade level (Grade 11 or 12), no restriction fields
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && (!('gradeLevel' in request.resource.data) || request.resource.data.gradeLevel in ['Grade 11', 'Grade 12', '11', '12'])
        && !('borrowRestrictedUntil' in request.resource.data)
        && !('restrictionReason' in request.resource.data);

      // Update own doc: cannot change role, borrowRestrictedUntil, or restrictionReason; gradeLevel must be 11 or 12 if changed
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && (!('gradeLevel' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.gradeLevel in ['Grade 11', 'Grade 12', '11', '12'])
        && !('role' in request.resource.data.diff(resource.data).affectedKeys())
        && !('borrowRestrictedUntil' in request.resource.data.diff(resource.data).affectedKeys())
        && !('restrictionReason' in request.resource.data.diff(resource.data).affectedKeys());

      // Admin can update any user (including role and restriction fields)
      allow update: if isAdmin();
    }

    // ── equipment ───────────────────────────────────────────────────────────
    match /equipment/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── settings ────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── requests ────────────────────────────────────────────────────────────
    match /requests/{docId} {
      // Student: create only with own userId and status "pending"
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Student: read only their own; admin reads all
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // Student: delete only their own pending request
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending';

      // Student: submit / re-submit return-proof photo on their own out-standing borrow.
      // May only move borrowed -> return_submitted (or return_flagged -> return_submitted)
      // and may only touch the return-proof fields.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status in ['borrowed', 'return_flagged']
        && request.resource.data.status == 'return_submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status',
             'returnProof',
             'returnSubmittedAt',
             'returnSubmittedNote',
             'proposedReturnDate',
             'returnAttempt',
             'updatedAt',
           ]);

      // Admin: full read, update, delete
      allow update, delete: if isAdmin();
    }

    // ── labBookings (Wet / Dry Laboratory room booking) ─────────────────────
    match /labBookings/{docId} {
      // Student: create only for self, status "pending"
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Student: read only their own; admin reads all
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // Student: delete only their own pending or rejected booking
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status in ['pending', 'rejected'];

      // Student: cancel their own pending booking only (no other field changes)
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status',
             'cancelledAt',
             'updatedAt',
           ]);

      // Admin: full read, update, delete
      allow update, delete: if isAdmin();
    }

    // ── warnings (account warnings / records) ───────────────────────────────
    match /warnings/{docId} {
      // Admin: full access
      allow read, write: if isAdmin();

      // Student: read only their own warnings
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── penalties ───────────────────────────────────────────────────────────
    match /penalties/{docId} {
      // Admin: full access
      allow read, write: if isAdmin();

      // Student: read only their own violations
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Everything else is denied by default (no catch-all)
  }
}
