rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is an admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEligibleStudent() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSignedIn()
        && request.auth.token.email_verified == true
        && profile.role == 'student'
        && profile.lrn is string
        && profile.lrn.matches('^[0-9]+$')
        && profile.gradeLevel in ['Grade 11', 'Grade 12', '11', '12'];
    }

    function bookingCreatedAfter(bookingId, bookingDate, labRoom) {
      let booking = getAfter(/databases/$(database)/documents/labBookings/$(bookingId)).data;
      return booking.userId == request.auth.uid
        && booking.status == 'pending'
        && booking.bookingDate == bookingDate
        && booking.labRoom == labRoom;
    }

    function bookingCalendarMatchesAfter(bookingId) {
      let booking = getAfter(/databases/$(database)/documents/labBookings/$(bookingId)).data;
      return booking.userId == request.auth.uid
        && booking.status == 'pending'
        && booking.bookingDate == request.resource.data.bookingDate
        && booking.labRoom == request.resource.data.labRoom
        && booking.startTime == request.resource.data.startTime
        && booking.endTime == request.resource.data.endTime;
    }

    // ── users ───────────────────────────────────────────────────────────────
    match /users/{uid} {
      // A signed-in user can read their own doc; admin can read all
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      // Create: only with role="student", matching uid, valid grade level (Grade 11 or 12), no restriction fields
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.lrn is string
        && request.resource.data.lrn.matches('^[0-9]+$')
        && (!('gradeLevel' in request.resource.data) || request.resource.data.gradeLevel in ['Grade 11', 'Grade 12', '11', '12'])
        && !('borrowRestrictedUntil' in request.resource.data)
        && !('restrictionReason' in request.resource.data);

      // Students may update only their own basic profile and notification
      // watermark. A missing LRN can be claimed only with its registry entry in
      // the same batch, which keeps duplicate LRNs from being assigned.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && resource.data.role == 'student'
        && request.resource.data.role == 'student'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name', 'lrn', 'gradeLevel', 'section', 'notifSeenAt', 'updatedAt',
           ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.gradeLevel in ['Grade 11', 'Grade 12', '11', '12']
        && request.resource.data.section is string
        && request.resource.data.section.size() > 0
        && request.resource.data.lrn is string
        && request.resource.data.lrn.matches('^[0-9]+$')
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lrn'])
          || (
            (!('lrn' in resource.data) || resource.data.lrn == null || resource.data.lrn == '')
            && getAfter(/databases/$(database)/documents/lrnRegistry/$(request.resource.data.lrn)).data.uid == request.auth.uid
          )
        );

      // Keep notification read markers working for legacy profiles that still
      // need to complete their required student details.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifSeenAt'])
        && request.resource.data.notifSeenAt is number;

      // Admin can update any user (including role and restriction fields)
      allow update: if isAdmin();
    }

    // A create-only registry makes each LRN globally unique without exposing
    // the registry to student reads or allowing an existing number to be replaced.
    match /lrnRegistry/{lrn} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.lrn == lrn
        && lrn.matches('^[0-9]+$')
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lrn == lrn;
      allow read, update, delete: if isAdmin();
    }

    // Append-only admin audit trail. No client, including admins, may edit or
    // erase a logged action after it has been created.
    match /adminActivity/{activityId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'actorUid', 'actorName', 'action', 'entityType', 'entityId',
             'summary', 'metadata', 'at',
           ]);
      allow update, delete: if false;
    }

    // ── equipment ───────────────────────────────────────────────────────────
    match /equipment/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Reservation entries expose only equipment availability windows; account
    // details stay on the private request documents.
    match /equipmentReservations/{reservationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── settings ────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── requests ────────────────────────────────────────────────────────────
    match /requests/{docId} {
      // Student: create only with own userId and status "pending"
      allow create: if isSignedIn()
        && isEligibleStudent()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.studentId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lrn
        && request.resource.data.gradeLevel == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gradeLevel
        && request.resource.data.status == 'pending';

      // Student: read only their own; admin reads all
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // Student: delete only their own pending request
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending';

      // Student: submit / re-submit return-proof photo on their own out-standing borrow.
      // May only move borrowed -> return_submitted (or return_flagged -> return_submitted)
      // and may only touch the return-proof fields.
      allow update: if isSignedIn()
        && isEligibleStudent()
        && resource.data.userId == request.auth.uid
        && resource.data.status in ['borrowed', 'return_flagged']
        && request.resource.data.status == 'return_submitted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status',
             'returnProofMeta',
             'returnSubmittedAt',
             'returnSubmittedNote',
             'proposedReturnDate',
             'returnAttempt',
             'updatedAt',
           ]);

      // Student may edit the request details only while it is still pending.
      // Identity, status, and original submission timestamps remain immutable.
      allow update: if isSignedIn()
        && isEligibleStudent()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'pending'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'teacher', 'experiment', 'experimentDate', 'proposedBorrowTime',
             'duration', 'expectedReturnDate', 'expectedReturnTime', 'items',
             'lateRequestFlag', 'labBookingId', 'labRoom', 'studentEditedAt', 'updatedAt',
           ]);

      // Admin: full read, update, delete
      allow update, delete: if isAdmin();
    }

    // Proof images are kept out of request documents so request tables do not
    // download large base64 payloads. Only the borrower and admins can read.
    match /requestProofs/{requestId} {
      allow read: if isSignedIn()
        && (isAdmin() || resource.data.userId == request.auth.uid);

      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'userId', 'contentType', 'size', 'width', 'height',
             'count', 'photos', 'capturedAt', 'attempt',
           ])
        && request.resource.data.photos is list
        && request.resource.data.photos.size() > 0
        && request.resource.data.photos.size() <= 5
        && getAfter(/databases/$(database)/documents/requests/$(requestId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/requests/$(requestId)).data.status == 'return_submitted';

      allow delete: if isAdmin();
    }

    // ── labBookings (laboratory room booking) ─────────────────────────────
    match /labBookings/{docId} {
      // Student: create only for self, status "pending"
      allow create: if isSignedIn()
        && isEligibleStudent()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.studentId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lrn
        && request.resource.data.gradeLevel == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gradeLevel
        && request.resource.data.bookingDate is string
        && request.resource.data.bookingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.startTime is string
        && request.resource.data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.endTime is string
        && request.resource.data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.startTime < request.resource.data.endTime
        && request.resource.data.labRoom is string
        && request.resource.data.labRoom.size() > 0
        && request.resource.data.status == 'pending';

      // Booking details contain LRN, teacher, section, and purpose. Students
      // can read their own record; admins can read all. The shared schedule
      // uses the sanitized labBookingCalendar collection below.
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // Student: delete only their own pending or rejected booking
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status in ['pending', 'rejected'];

      // Student: cancel their own pending booking only (no other field changes)
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status in ['pending', 'approved']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status',
             'cancelledAt',
             'cancellationReason',
             'updatedAt',
           ]);

      // Admin: full read, update, delete
      allow update, delete: if isAdmin();
    }

    match /labBookingCalendar/{bookingId} {
      allow read: if isSignedIn();

      // The student creates a private booking and its public, redacted calendar
      // entry in the same atomic transaction.
      allow create: if request.resource.data.keys().hasOnly([
             'bookingDate', 'labRoom', 'startTime', 'endTime', 'status',
           ]) && (
        isAdmin() || (isEligibleStudent()
          && request.resource.data.status == 'pending'
          && request.resource.data.bookingDate is string
          && request.resource.data.bookingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.startTime is string
          && request.resource.data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.endTime is string
          && request.resource.data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.startTime < request.resource.data.endTime
          && request.resource.data.labRoom is string
          && request.resource.data.labRoom.size() > 0
          && bookingCalendarMatchesAfter(bookingId))
      );

      // Student cancellation must update the private record and calendar view
      // atomically; admins may sync any status change.
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.status in ['pending', 'approved']
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && getAfter(/databases/$(database)/documents/labBookings/$(bookingId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/labBookings/$(bookingId)).data.status == 'cancelled'
      );
      allow delete: if isAdmin();
    }

    // A room/date mutex makes simultaneous booking submissions serialize before
    // their availability query is committed. It carries no student information.
    match /labBookingMutex/{mutexId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (
        isEligibleStudent()
        && request.resource.data.keys().hasOnly(['bookingId', 'bookingDate', 'labRoom', 'revision'])
        && request.resource.data.revision == 1
        && bookingCreatedAfter(request.resource.data.bookingId, request.resource.data.bookingDate, request.resource.data.labRoom)
      );
      allow update: if isAdmin() || (
        isEligibleStudent()
        && request.resource.data.keys().hasOnly(['bookingId', 'bookingDate', 'labRoom', 'revision'])
        && request.resource.data.revision == resource.data.revision + 1
        && bookingCreatedAfter(request.resource.data.bookingId, request.resource.data.bookingDate, request.resource.data.labRoom)
      );
      allow delete: if isAdmin();
    }

    // ── warnings (account warnings / records) ───────────────────────────────
    match /warnings/{docId} {
      // Admin: full access
      allow read, write: if isAdmin();

      // Student: read only their own warnings
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── penalties ───────────────────────────────────────────────────────────
    match /penalties/{docId} {
      // Admin: full access
      allow read, write: if isAdmin();

      // Student: read only their own violations
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Everything else is denied by default (no catch-all)
  }
}
